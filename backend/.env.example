NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/splitpayng
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-a-64-char-random-secret
PAYSTACK_SECRET_KEY=sk_test_replace_me
RESEND_API_KEY=re_replace_me
FROM_EMAIL=noreply@example.com
# Number of reverse proxies in front of the app. 1 for a single PaaS router
# (Railway/Render), 2 if Cloudflare is also in front, 0 if none. A wrong value
# either lets clients spoof their IP to bypass rate limits (too high) or makes
# all users share one rate-limit bucket (too low).
TRUST_PROXY=1
# Database query timeout (ms) for GET /api/health (allow time for serverless Postgres cold starts)
HEALTH_DB_TIMEOUT_MS=5000
